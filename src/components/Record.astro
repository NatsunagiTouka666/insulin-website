---
import Gallery from './Gallery.astro';
import { words } from '../lib/content.js';
const { record, lang, detail = false } = Astro.props;
const t = words[lang];
const images = detail || !record.detail ? record.images || [] : (record.images || []).slice(0, 1);
---
<article class="archive-entry" data-record={record.id} data-reading-anchor={`record-${record.id}`}>
  <div class="entry-heading"><span class="eyebrow">{record.date || `${t.entry} / ${record.id}`}</span>{record.tags?.length > 0 && <span class="eyebrow">{record.tags.join(' · ')}</span>}</div>
  {detail ? <h1>{record.title?.[lang] || t.entry}</h1> : record.title?.[lang] && <h2>{record.title[lang]}</h2>}
  <Gallery images={images} lang={lang} id={record.id} priority={detail} />
  {record.text?.[lang] && <p class="entry-text">{record.text[lang]}</p>}
  {record.video?.rightsConfirmed && <div class="video-wrap">
    <video controls playsinline preload="none" poster={record.video.poster || undefined} aria-label={record.title?.[lang] || t.entry}>
      <source src={record.video.src} type={record.video.type || 'video/mp4'} />
      {record.video.captions?.map(c => <track kind="captions" src={c.src} srclang={c.lang} label={c.label} />)}
    </video>
    <p class="video-error" role="status" hidden>{t.videoError}</p>
  </div>}
  {record.detail && !detail && <a class="text-link" data-open-record={record.id} href={`/${lang}/archive/${record.id}/`}>{t.detail}<span aria-hidden="true">↗</span></a>}
</article>
